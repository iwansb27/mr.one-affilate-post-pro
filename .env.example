# ============================================
# AffiliatePost Pro - Environment Variables
# ============================================
# 
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ============================================
# SUPABASE (Database & Auth) - Optional for MVP
# ============================================
# VITE_SUPABASE_URL=your-project-url.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# BUFFER (Publishing Provider) - PRIMARY
# ============================================
# Get from: https://buffer.com/developers/api
# This is the main publishing provider for MVP.
# All posts go through Buffer → Facebook/TikTok/YouTube
VITE_BUFFER_ACCESS_TOKEN=

# ============================================
# AI CONTENT GENERATION (Optional)
# ============================================
# OpenAI API for AI-powered caption generation
# If not set, template engine will be used instead.
# VITE_OPENAI_API_KEY=
