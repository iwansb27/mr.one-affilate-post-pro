# ============================================
# AffiliatePost Pro - Environment Variables
# ============================================
# 
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# IMPORTANT: API secrets should be server-side only.
# VITE_ prefixed variables are exposed to the browser.
# For production, use Supabase Edge Functions to proxy API calls.

# ============================================
# SUPABASE (Database & Auth)
# ============================================
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# SHOPEE AFFILIATE API
# ============================================
# Get from: https://affiliate.shopee.co.id/
# Status: NOT CONFIGURED
VITE_SHOPEE_APP_KEY=
VITE_SHOPEE_APP_SECRET=

# ============================================
# LAZADA AFFILIATE API
# ============================================
# Get from: https://affiliate.lazada.co.id/
# Status: NOT CONFIGURED
VITE_LAZADA_APP_KEY=
VITE_LAZADA_APP_SECRET=

# ============================================
# TOKOPEDIA AFFILIATE API
# ============================================
# Get from: https://affiliate.tokopedia.com/
# Status: NOT CONFIGURED
VITE_TOKOPEDIA_CLIENT_ID=
VITE_TOKOPEDIA_CLIENT_SECRET=

# ============================================
# META (Facebook + Instagram) API
# ============================================
# Get from: https://developers.facebook.com/apps/
# Status: NOT CONFIGURED
VITE_META_APP_ID=
VITE_META_APP_SECRET=

# ============================================
# YOUTUBE API (Google OAuth)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
# Status: NOT CONFIGURED
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_CLIENT_SECRET=

# ============================================
# TIKTOK API
# ============================================
# Get from: https://developers.tiktok.com/
# Status: NOT CONFIGURED
VITE_TIKTOK_CLIENT_KEY=
VITE_TIKTOK_CLIENT_SECRET=

# ============================================
# AI CONTENT GENERATION (Optional)
# ============================================
# OpenAI API for AI-powered caption generation
# Status: NOT CONFIGURED
# VITE_OPENAI_API_KEY=

# ============================================
# ENCRYPTION (Server-side only)
# ============================================
# Used for encrypting OAuth tokens in database
# TOKEN_ENCRYPTION_KEY=your-encryption-key
